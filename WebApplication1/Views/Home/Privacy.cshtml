@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>

<div class="card shadow-sm mt-3">
    <div class="card-body">
        <h5 class="fw-bold">What we collect</h5>
        <p class="text-muted mb-3">
            When you register, we store your username, an optional email address, and a hashed password.
            We also store game history, chat messages, friend connections, and rating (Elo) statistics
            so the site can function.
        </p>

        <h5 class="fw-bold">How we use it</h5>
        <p class="text-muted mb-3">
            Your data is used solely to operate the chess service: matching games, calculating ratings,
            showing leaderboards, delivering chat, and preserving game history and replays.
        </p>

        <h5 class="fw-bold">What we never do</h5>
        <p class="text-muted mb-3">
            We do not sell or share your personal data with third parties, and we do not use it for
            advertising or tracking.
        </p>

        <h5 class="fw-bold">Security</h5>
        <p class="text-muted mb-3">
            Passwords are hashed with a modern password hasher and never stored in plain text.
            Sessions use secure, sliding cookies.
        </p>

        <h5 class="fw-bold">Account deletion</h5>
        <p class="text-muted mb-0">
            To delete your account and associated data, contact the site administrator. Game and chat
            records may be retained for operational purposes.
        </p>
    </div>
</div>