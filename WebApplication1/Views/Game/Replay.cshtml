@model GameRecord
@{
    ViewData["Title"] = "Replay";
    var moves = string.IsNullOrEmpty(Model.MovesJson) ? new List<string>() : System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.MovesJson) ?? new List<string>();
    var whiteWon = Model.Status == "WhiteWon";
}
<div class="row g-3">
    <div class="col-lg-7 col-xl-6">
        <div class="card shadow-sm">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between mb-2">
                    <div class="fw-bold">@(Model.WhitePlayer?.UserName ?? "Bot") (white) vs @(Model.BlackPlayer?.UserName ?? "Bot") (black)</div>
                    <div>
                        @if (Model.Status == "Draw") { <span class="badge bg-secondary">Draw - @Model.ResultReason</span> }
                        else { <span class="badge @(whiteWon ? "bg-success" : "bg-danger")">@(whiteWon ? Model.WhitePlayer?.UserName ?? "Bot" : Model.BlackPlayer?.UserName ?? "Bot") wins - @Model.ResultReason</span> }
                    </div>
                </div>
                <div id="board" style="max-width:560px;margin:0 auto;"></div>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button id="btnPrev" class="btn btn-outline-secondary btn-sm">&#9664; Prev</button>
                    <button id="btnNext" class="btn btn-outline-secondary btn-sm">Next &#9654;</button>
                    <button id="btnAuto" class="btn btn-outline-primary btn-sm">Autoplay</button>
                    <button id="btnStart" class="btn btn-outline-dark btn-sm">|&lt;</button>
                    <button id="btnEnd" class="btn btn-outline-dark btn-sm">&gt;|</button>
                </div>
                <div class="text-center text-muted small mt-2">
                    <span id="moveCount"></span> of @moves.Count moves
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5 col-xl-6">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Moves</div>
            <div class="card-body p-2" id="moveList" style="max-height:400px;overflow-y:auto;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/board.js" asp-append-version="true"></script>
    <script>
        (function () {
            var moves = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(moves));
            var chess = new Chess();
            var board = ChessBoard.create(document.getElementById('board'), { interactive: false });
            var idx = 0;

            function render() {
                board.setFen(chess.fen());
                var vh = chess.history({ verbose: true });
                if (vh.length) board.setLastMove({ from: vh[vh.length - 1].from, to: vh[vh.length - 1].to });
                document.getElementById('moveCount').textContent = vh.length;
                var rows = [];
                for (var i = 0; i < moves.length; i++) {
                    if (i % 2 === 0) rows.push('<tr><td>' + (Math.floor(i / 2) + 1) + '.</td>');
                    rows.push('<td>' + moves[i] + '</td>');
                    if (i % 2 === 1) rows.push('</tr>');
                }
                if (moves.length % 2 === 1) rows.push('<td></td></tr>');
                document.getElementById('moveList').innerHTML = '<table class="table table-sm mb-0">' + rows.join('') + '</table>';
            }

            function go(i) {
                while (idx < i && idx < moves.length) { chess.move(moves[idx]); idx++; }
                while (idx > i && idx > 0) { chess.undo(); idx--; }
                render();
            }

            document.getElementById('btnNext').onclick = function () { go(idx + 1); };
            document.getElementById('btnPrev').onclick = function () { go(idx - 1); };
            document.getElementById('btnStart').onclick = function () { go(0); };
            document.getElementById('btnEnd').onclick = function () { go(moves.length); };

            var autoTimer = null;
            document.getElementById('btnAuto').onclick = function () {
                if (autoTimer) { clearInterval(autoTimer); autoTimer = null; this.textContent = 'Autoplay'; return; }
                var btn = this;
                autoTimer = setInterval(function () {
                    if (idx >= moves.length) { clearInterval(autoTimer); autoTimer = null; btn.textContent = 'Autoplay'; return; }
                    go(idx + 1);
                }, 700);
                btn.textContent = 'Stop';
            };

            render();
        })();
    </script>
}