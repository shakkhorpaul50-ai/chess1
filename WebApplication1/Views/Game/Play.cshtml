@{
    ViewData["Title"] = "Game";
    var gameId = ViewData["GameId"]?.ToString() ?? "";
}
@Html.AntiForgeryToken()
<div class="row g-3">
    <div class="col-lg-7 col-xl-6">
        <div class="card shadow-sm">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="text-center">
                        <div class="fw-bold" id="blackName">Black</div>
                        <div id="clockBlack" class="clock">--:--</div>
                    </div>
                    <span id="gameStatus" class="badge bg-secondary">Loading...</span>
                    <div class="text-center">
                        <div class="fw-bold" id="whiteName">White</div>
                        <div id="clockWhite" class="clock">--:--</div>
                    </div>
                </div>
                <div id="board" style="max-width:560px;margin:0 auto;"></div>
                <div class="text-center text-muted small mt-2" id="turnHint"></div>
            </div>
        </div>
        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <button id="btnResign" class="btn btn-danger btn-sm" style="display:none;">Resign</button>
                    <button id="btnDraw" class="btn btn-secondary btn-sm" style="display:none;">Offer Draw</button>
                    <button id="btnCancel" class="btn btn-outline-danger btn-sm" style="display:none;">Cancel lobby</button>
                    <button id="btnAcceptDraw" class="btn btn-success btn-sm" style="display:none;">Accept Draw</button>
                    <button id="btnDeclineDraw" class="btn btn-outline-secondary btn-sm" style="display:none;">Decline</button>
                    <a href="/Game/History" class="btn btn-outline-secondary btn-sm">History</a>
                </div>
                <div id="waitingNote" class="text-center mt-2 d-none">
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                    <div class="mt-1">Waiting for an opponent... Share this link:</div>
                    <input id="shareLink" class="form-control form-control-sm mt-1 text-center" readonly />
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5 col-xl-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-bold">Moves</div>
            <div class="card-body p-2" id="moveList" style="max-height:220px;overflow-y:auto;"></div>
        </div>
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Game Chat</div>
            <div class="card-body p-2">
                <div id="chatBox" style="height:220px;overflow-y:auto;" class="border rounded p-2 mb-2 bg-light"></div>
                <div class="input-group input-group-sm">
                    <input id="chatInput" class="form-control" maxlength="500" placeholder="Message... (visible to players &amp; spectators)" />
                    <button id="chatSend" class="btn btn-primary">Send</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="gameOverModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <h3 id="overResult" class="mb-1">Game over</h3>
                <p id="overMsg" class="text-muted mb-1"></p>
                <p id="overReason" class="badge bg-secondary"></p>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button id="btnRematch" class="btn btn-success" style="display:none;">Rematch</button>
                    <button id="btnAcceptRematch" class="btn btn-success" style="display:none;">Accept Rematch</button>
                    <button id="btnDeclineRematch" class="btn btn-outline-secondary" style="display:none;">Decline</button>
                    <a href="/" class="btn btn-primary">Back to Lobby</a>
                    <a href="/Game/History" class="btn btn-outline-secondary">History</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="promoModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <div class="mb-2 fw-bold">Promote to</div>
                <div class="d-flex justify-content-center gap-2 display-6">
                    <button class="btn btn-outline-dark" data-piece="q">&#9813;</button>
                    <button class="btn btn-outline-dark" data-piece="r">&#9814;</button>
                    <button class="btn btn-outline-dark" data-piece="b">&#9815;</button>
                    <button class="btn btn-outline-dark" data-piece="n">&#9816;</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/board.js" asp-append-version="true"></script>
    <script src="~/js/stockfish.js" asp-append-version="true"></script>
    <script src="~/js/game.js" asp-append-version="true"></script>
    <script>
        (function () {
            document.addEventListener('DOMContentLoaded', function () {
                var gameId = new URLSearchParams(location.search).get('id');
                var uid = App.myUserId;
                document.getElementById('btnResign').addEventListener('click', function () {
                    if (confirm('Resign this game?')) App.gameHub().then(function (h) { return h.invoke('Resign', gameId); }).catch(function (e) { App.toast(e.message || e, true); }).finally(function () {
                        var st = document.getElementById('gameStatus');
                        if (st) st.textContent = 'You resigned';
                    });
                });
                document.getElementById('btnDraw').addEventListener('click', function () {
                    App.gameHub().then(function (h) { return h.invoke('OfferDraw', gameId); }).catch(function (e) { App.toast(e.message || e, true); });
                });
                document.getElementById('btnAcceptDraw').addEventListener('click', function () {
                    App.gameHub().then(function (h) { return h.invoke('AcceptDraw', gameId); }).catch(function (e) { App.toast(e.message || e, true); });
                });
                document.getElementById('btnDeclineDraw').addEventListener('click', function () {
                    App.gameHub().then(function (h) { return h.invoke('DeclineDraw', gameId); }).catch(function (e) { App.toast(e.message || e, true); });
                });
                document.getElementById('btnCancel').addEventListener('click', function () {
                    App.gameHub().then(function (h) { return h.invoke('CancelGame', gameId); }).then(function () { location.href = '/'; }).catch(function (e) { App.toast(e.message || e, true); });
                });
                document.getElementById('btnRematch').addEventListener('click', function () {
                    App.gameHub().then(function (h) { return h.invoke('OfferRematch', gameId); }).then(function (newId) {
                        if (newId) location.href = '/Game/Play?id=' + newId;
                    }).catch(function (e) { App.toast(e.message || e, true); });
                });
                document.getElementById('btnAcceptRematch').addEventListener('click', function () {
                    App.gameHub().then(function (h) { return h.invoke('AcceptRematch', gameId); }).then(function (newId) {
                        if (newId) location.href = '/Game/Play?id=' + newId;
                    }).catch(function (e) { App.toast(e.message || e, true); });
                });
                document.getElementById('btnDeclineRematch').addEventListener('click', function () {
                    App.gameHub().then(function (h) { return h.invoke('DeclineRematch', gameId); }).catch(function (e) { App.toast(e.message || e, true); });
                });
            });
        })();
    </script>
}