@{
    ViewData["Title"] = "Chat with " + ViewData["OtherName"];
    var otherId = ViewData["OtherId"]?.ToString() ?? "";
    var otherName = ViewData["OtherName"]?.ToString() ?? "?";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header fw-bold d-flex justify-content-between align-items-center">
                <span>Private Chat - @otherName</span>
                <div>
                    <button class="btn btn-sm btn-success" id="btnChallenge">Challenge to a game</button>
                    <a href="/Friends" class="btn btn-sm btn-outline-secondary">Back</a>
                </div>
            </div>
            <div class="card-body p-2">
                <div id="chatBox" style="height:420px;overflow-y:auto;" class="border rounded p-2 mb-2 bg-light"></div>
                <div class="input-group">
                    <input id="chatInput" class="form-control" maxlength="500" placeholder="Message @otherName..." />
                    <button id="chatSend" class="btn btn-primary">Send</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.PrivateChat = (function () {
            var chatBox, input, sendBtn, hub = null;
            var otherId = '@otherId';

            function escapeHtml(s) {
                var d = document.createElement('div');
                d.textContent = s;
                return d.innerHTML;
            }

            function appendChat(m) {
                var div = document.createElement('div');
                div.className = 'chat-msg' + (m.senderId === App.myUserId ? ' mine' : '');
                div.innerHTML = '<b>' + escapeHtml(m.senderName || '?') + '</b> ' + escapeHtml(m.content) +
                    '<span class="chat-time">' + App.fmtTime(m.sentAt) + '</span>';
                chatBox.appendChild(div);
                chatBox.scrollTop = chatBox.scrollHeight;
            }

            function send() {
                var text = input.value.trim();
                if (!text) return;
                hub.invoke('SendPrivate', otherId, text).catch(function (e) { App.toast(e.message || e, true); });
                input.value = '';
            }

            async function init() {
                chatBox = document.getElementById('chatBox');
                input = document.getElementById('chatInput');
                sendBtn = document.getElementById('chatSend');
                hub = await App.chatHub();
                hub.on('PrivateMessageReceived', function (m) { if (m.senderId === otherId || m.receiverId === otherId) appendChat(m); });

                App.fetchJson('/Friends/ChatData?userId=' + encodeURIComponent(otherId)).then(function (msgs) {
                    chatBox.innerHTML = '';
                    msgs.forEach(appendChat);
                }).catch(function () { });

                sendBtn.onclick = send;
                input.addEventListener('keydown', function (e) { if (e.key === 'Enter') send(); });
            }

            document.addEventListener('DOMContentLoaded', init);
            return {
                connect: function () { return init(); }
            };
        })();
    </script>
}