@model ApplicationUser
@{
    ViewData["Title"] = Model.UserName ?? "Profile";
    var games = (List<GameRecord>?)ViewData["Games"] ?? new();
    var isMe = (bool?)ViewData["IsMe"] ?? false;
}
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-body text-center p-4">
                <div class="display-3 mb-2">&#9812;</div>
                <h4>@Model.UserName</h4>
                <div class="text-muted small">Joined @Model.CreatedAt.ToLocalTime().ToString("MMM yyyy")</div>
                @if (!isMe && User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Friends" asp-action="Add" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@Model.Id" />
                        <button class="btn btn-outline-primary">Add Friend</button>
                    </form>
                }
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-3">
                        <div class="fw-bold fs-5">@Model.Elo</div>
                        <div class="text-muted small">ELO</div>
                    </div>
                    <div class="col-3">
                        <div class="fw-bold fs-5">@Model.Points</div>
                        <div class="text-muted small">Points</div>
                    </div>
                    <div class="col-3">
                        <div class="fw-bold fs-5 text-success">@Model.Wins</div>
                        <div class="text-muted small">Wins</div>
                    </div>
                    <div class="col-3">
                        <div class="fw-bold fs-5 text-danger">@Model.Losses</div>
                        <div class="text-muted small">Losses</div>
                    </div>
                    <div class="col-12 mt-3">
                        <div class="fw-bold">@Model.Draws draws in @(Model.Wins + Model.Draws + Model.Losses) games</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Recent Games</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>White</th><th>Black</th><th>Result</th><th>Date</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var g in games)
                            {
                                <tr>
                                    <td>@(g.WhitePlayer?.UserName ?? "Bot")</td>
                                    <td>@(g.BlackPlayer?.UserName ?? "Bot")</td>
                                    <td>
                                        @if (g.Status == "Draw") { <span class="text-secondary fw-bold">Draw</span> }
                                        else if (g.Status == "WhiteWon") { <span class="text-success fw-bold">@(g.WhitePlayer?.UserName ?? "Bot") won</span> }
                                        else if (g.Status == "BlackWon") { <span class="text-danger fw-bold">@(g.BlackPlayer?.UserName ?? "Bot") won</span> }
                                        else { <span class="text-muted">@g.Status</span> }
                                    </td>
                                    <td class="text-muted small">@g.CreatedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm")</td>
                                    <td>
                                        @if (g.Status == "InProgress")
                                        {
                                            <a class="btn btn-sm btn-outline-primary" asp-controller="Spectate" asp-action="Watch" asp-route-id="@g.Id">Watch</a>
                                        }
                                        else if (g.Status != "Waiting")
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Game" asp-action="Replay" asp-route-id="@g.Id">Replay</a>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!games.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">No games yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>