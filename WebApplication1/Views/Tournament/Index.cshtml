@model List<TournamentListViewModel>
@{
    ViewData["Title"] = "Tournaments";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Tournaments</h4>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">Create Tournament</a>
    }
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th>Name</th><th>Players</th><th>Time</th><th>Format</th><th>Status</th><th>Created</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="fw-bold">@t.Name</td>
                            <td>
                                @t.PlayerCount / @t.MaxPlayers
                                @if (t.JoinedByMe)
                                {
                                    <span class="badge bg-success">You</span>
                                }
                            </td>
                            <td>@t.Minutes min</td>
                            <td>Round-robin</td>
                            <td>
                                <span class="badge @(t.Status == "Open" ? "bg-success" : t.Status == "InProgress" ? "bg-warning" : "bg-secondary")">@t.Status</span>
                            </td>
                            <td class="text-muted small">@t.CreatedAt.ToLocalTime().ToString("MMM d")</td>
                            <td><a class="btn btn-sm btn-outline-primary" asp-action="Detail" asp-route-id="@t.Id">Open</a></td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No tournaments yet.
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <a asp-action="Create">Create the first one!</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>